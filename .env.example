# Copy to infra/.env, set strong random secrets, NEVER commit that file.
# Supabase Data API (PostgREST). The API server talks to /rest/v1/rpc/* over HTTPS;
# no JDBC driver, no DB connection string, no connection pool.
SUPABASE_URL=https://<project>.supabase.co
# Server-side only: grants full data access, never ship to the browser.
SUPABASE_SERVICE_ROLE_KEY=REPLACE_WITH_SERVICE_ROLE_KEY
# Optional: Ark anon key. The SocialTask password flow and API do not use it.
SUPABASE_ANON_KEY=REPLACE_WITH_ANON_KEY
BOOTSTRAP_ADMIN_USERNAME=
BOOTSTRAP_ADMIN_PASSWORD=
APP_PUBLIC_URL=http://localhost:3000
SESSION_COOKIE_SECURE=false
SCHEDULER_ENABLED=true
# Required for scheduling. Generate with openssl rand -hex 32.
CRON_SECRET=
FOLLOWUP_MAX_ACTIVE_TASKS=10
# Private message screenshots auto-purge after N days (1-3650); content assets default to 0 (no auto-purge).
ATTACHMENT_PM_RETENTION_DAYS=90
ATTACHMENT_CONTENT_RETENTION_DAYS=0
# Enterprise WeChat only sends to eligible employees in the configured application's visibility range.
WECOM_ENABLED=false
# OAuth is independent of outbound messages. Requires HTTPS APP_PUBLIC_URL.
WECOM_OAUTH_ENABLED=false
WECOM_CORP_ID=
WECOM_AGENT_ID=0
WECOM_AGENT_SECRET=
# Application callback is independent of outbound card sending.
# Requires a HTTPS public endpoint /api/v1/wecom/callback and correct app callback settings.
WECOM_CALLBACK_ENABLED=false
WECOM_CALLBACK_TOKEN=
WECOM_ENCODING_AES_KEY=
WECOM_RETENTION_DAYS=90

# Explicit media download/upload; outbound additionally requires WECOM_ENABLED=true.
WECOM_MEDIA_ENABLED=false

# Independent WeChat Customer Service account; disabled until explicit authorization.
WECOM_KF_ENABLED=false
WECOM_KF_AUTHORIZED=false
WECOM_KF_ACCOUNT_ID=
WECOM_KF_SECRET=
WECOM_KF_RETENTION_DAYS=30

# Server-side model profile; use a secret manager and deployment-controlled exact HTTPS origins.
# 32 random bytes encoded with standard Base64. Never reuse the WeCom AES key.
SOCIALTASK_CONFIG_KEY=
SOCIALTASK_LLM_ALLOWED_ORIGINS=
